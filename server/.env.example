# Flask
FLASK_ENV=development
SECRET_KEY=change-me-long-random-string
# 32-byte urlsafe base64 key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Google OAuth (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Comma separated. Empty = anyone may request sign-up (admins approve in the app).
ALLOWED_EMAILS=
# Service admins (comma separated): auto-approved, can approve/reject/delete accounts.
ADMIN_EMAILS=you@example.com

# OTP
OTP_ISSUER=MightyTrade

# Session
ACCESS_TOKEN_TTL_MIN=720
COOKIE_SECURE=false

# Storage: json (file DB) | sqlite (WAL mode, recommended for single VM) | supabase (TODO)
STORAGE_BACKEND=json
DATA_DIR=./data

# Market data providers per market: mock | toss
MARKET_PROVIDER_KR=mock
MARKET_PROVIDER_US=mock

# Toss Securities Open API. Each user registers their own key in the app (설정 > 토스증권 API).
# Users must add this server's public IP to 허용 IP 관리 in Toss WTS.
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# Trading safety limits (per user)
TRADING_UNLOCK_MIN=30            # OTP unlock for manual orders lasts this many minutes
TRADING_MAX_ORDERS_PER_DAY=50    # manual + bot orders
TRADING_MAX_ORDER_KRW=50000000   # max value of a single order
TRADING_MAX_ORDER_USD=50000

# Auto-trading scheduler (runs in the serving process, one per server via a file lock)
AUTOTRADE_SCHEDULER=true

# Process pool workers for heavy quant jobs (optimize / walk-forward / Monte Carlo; 0 = in-process)
QUANT_WORKERS=2
