# /etc/systemd/system/mighty-trade-api.service
[Unit]
Description=MightyTrade Rust API (axum + tokio)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/mighty-trade/server
EnvironmentFile=/opt/mighty-trade/server/.env
# Single async Rust binary: holds one Toss WebSocket per user in memory, serves SSE streams,
# runs Rayon-parallel quant jobs, and executes the background autotrade scheduler.
ExecStart=/opt/mighty-trade/server-rs/mighty-trade-server
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
