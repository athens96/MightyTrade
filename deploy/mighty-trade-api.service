# /etc/systemd/system/mighty-trade-api.service
[Unit]
Description=MightyTrade Flask API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/mighty-trade/server
EnvironmentFile=/opt/mighty-trade/server/.env
ExecStart=/opt/mighty-trade/server/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5001 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
