# /etc/systemd/system/mighty-trade-api.service
[Unit]
Description=MightyTrade Flask API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/mighty-trade/server
EnvironmentFile=/opt/mighty-trade/server/.env
# One process with threads: the realtime relay keeps one Toss WebSocket per user in memory (Toss allows
# only 2 per account), and SSE connections are long-lived — so a single gthread worker, not several workers.
ExecStart=/opt/mighty-trade/server/.venv/bin/gunicorn --worker-class gthread --workers 1 --threads 32 --timeout 120 -b 127.0.0.1:5001 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
